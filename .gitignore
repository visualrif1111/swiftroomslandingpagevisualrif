node_modules
.vercel

# Build output — generated by `vite build`; Vercel builds from source
dist

# Environment / secrets — never commit real values (keep .env.example only)
.env
.env.*
!.env.example

# pnpm — this repo standardises on npm (package-lock.json is the source of truth,
# CI and Vercel build with npm). Keep local pnpm artifacts out of the tree so the
# committed, audited dependency set can't silently diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
